CREATE TABLE players (
    is INTEGER PRIMARY KEY,
    name TEXT NOT NULL
);

CREATE TABLE ranks (
    player_id INTEGER PRIMARY KEY,
    rank INTEGER NOT NULL,
    FOREIGN KEY (player_id) REFERENCES players(is)
);

CREATE TRIGGER add_player_to_ranks
AFTER INSERT ON players
BEGIN
    INSERT INTO ranks (player_id, rank)
    VALUES (NEW.is, 100);
END;


